# Copy to server/.env and fill in.
PORT=5000

# MongoDB Atlas (or any MongoDB) connection string.
# Leave unset in development to use an embedded MongoDB (data in ~/.clock-it/mongo,
# or set EMBEDDED_DB_PATH).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/clockit

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of front-end origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173
